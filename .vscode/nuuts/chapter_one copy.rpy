            $ kh_change("chingun", -1)
            ch_b "Тэр талаар ярих хүсэл алга."
        "Хариулах (ёжлох)":
            $ kh_change("chingun", 1)
            kh_b "Миний амьдралыг надаас сайн мэддэг болж дээ."
        "Хариулах (үл тоох)":
            $ kh_change("anu", -1)
            ch_b "Хичээл хэдээс билээ?"
    ch_c "Еээ. За тийм байх аа. Уул нь хөөрхөн охин тэ? Маньтайгаа танилцуулчаач"
    ckh_b "За хуцаадай. Хичээлдээ орцгооё"
    "Билгүүн босож явахад утасанд нь чат ирнэ. Билгүүн утсаа харахад"
    "Ану гэх охиноос чат ирсэн байх ба билгүүний хариу бичээгүй маш удаан үргэлжлэх зөвхөн Ану л бичсэн байх хуучин чатууд харагдана."
    ch_a "Хичээлийн эхний өдөрт нь амжилт. Чи хамгийн мундаг нь шүү."
    "Ану өөрийн дуулсан гитартай cover бичлэгээ явуулжээ."
    $ kh_receive("anu", "Хичээлийн эхний өдөрт нь амжилт. Чи хамгийн мундаг нь шүү.")
    call kh_listen_cover

    "Дуугаа сонсон Билгүүн сургуулийн коридороор алхана."

    $ stat_location = "Сургуулийн коридор · Өдөр"
    scene expression kh_background("corridor") with dissolve
    show screen kh_scene_header

    "Анугын дуу дуусмагц Билгүүн цонхоор харахаар цонхны тавцан дээр сууна. Энэ үед сургуулийн гадаа лаг машин ирж зогсох ба том биетэй жолооч арын хаалгийг нээн дотроос нь сургуулийн формтой бөгөөд үнэтэй чамин зүйлсээр өөрийгөө гоёсон үеийн охин бууж ирнэ.Энэ үед Билгүүний хажууд Чингүн ирнэ."
    kh_c "Наачин ёстой гоё охин байгаа биз Жинхэнэ баригдахгүй муужгай муур.Манай сургуулийн төгсөх курс гэсэн."
    call screen kh_timed_choice(["Нэр асуух", "IG асуух", "Ажлыг нь асуух", "Үл тоох"], 10.0)
    $ stat_flags["saruul_question"] = _return
    $ stat_following_saruul = (_return == 1)
    $ kh_intro_order = [_return] + [i for i in range(3) if i != _return]
    $ kh_intro_index = 0
    while kh_intro_index < len(kh_intro_order):
        $ kh_question = kh_intro_order[kh_intro_index]
        if kh_question < 3:
            $ kh_intro_text = ["Жинхэнэ нэрийг нь мэдэх хүн байхгүй.", "IG нь энэ байна. Чи хүсвэл дагаарай.", "IG influencer байхгүй юу."][kh_question]
            kh_c "[kh_intro_text]"
        $ kh_intro_index += 1


    $ stat_location = "Сэтгэл судлалын хичээл"
    scene expression kh_background("classroom") with dissolve
    show screen kh_scene_header

    "Багш орж ирэв. Билгүүн ангийнхаа хүүхдүүдийг сониучирхан ажиглана."
    call kh_inspect("classroom")
    ch_t "Билгүүн... байхаа. Миний асуултанд хариулах уу?"
    menu:
        "Багшийн асуултад"
        "Итгэлтэй хариулах":
            $ kh_change("confidence", 2)
            ch_t "(хүүхдүүд шоолж инээнэ)чи асуултаа буруу сонссон бололтой.Чи ямар авьяастай вэ?"
        "Мэдэн будилах":
            $ kh_change("confidence", -1)
            ch_t "(хүүхдүүд шоолж инээнэ) зуны амралт чинь дуусчихсан шүү Билгүүнээ. Чиний авьяас юу вэ?"
        "Тойруулах":
            $ kh_change("confidence", 1)
            ch_t "Сонирхолтой авьяас байна.:ахиад асууя чиний авьяас юу вэ?"
        "Татгалзах":
            $ stat_flags["declined_teacher"] = True
            ch_t "Ойлгомжтой.Өөр хариулах хүүхэд байна уу? (шууд Хулан-руу)"
    if not stat_flags.get("declined_teacher"):
        ch_b "Надад авьяас байхгүй ээ."
        ch_t "Ойлгомжтой.Өөр хариулах хүүхэд байна уу?"
    "Хулан бослоо."
    ch_k "Багшаа би зурах дуртай. Надад бага зэрэг авьяас байдаг юм шиг санагддаг."
    "Энэ үед Хулангын хажууд суух Чингүн хулангын зургийн дэвтрийг өргөөд"
    ch_c "Багшаа тийм байна. Билгүүнийг үнэхээр гоё зурсан байна шүү. гэж ангиар дүүрэн орилно."
    ch_k "Чи болиоч. Наадхаа аваад ир."
    ch_c "Май Билгүүнээ андаа аваарай дурсгал"
