    $ stat_following_saruul = True
    $ stat_notice = "Саруул таныг буцааж дагалаа."
    $ phone_unlocked = True
    $ phone_view = "social"

    "Утсаа шалгав. Moment-д 52 дагагч, дагасан 52 хаяг байна. Өнөөдөр таарсан хүмүүсийн нийтлэл, story харагдана."
    hide screen kh_scene_header
    call screen phone_ui
    show screen kh_scene_header

    "Билгүүн утсаа тавиад нүдээ анив."

    $ stat_location = "Зүүд"
    scene expression kh_background("dream") with dissolve
    show screen kh_scene_header

    "Хулангийн өрөөнд тэр хоёрын тэврэлдсэн зураг байв. Цаанаас танил хоолой сонсогдоно."
    ch_k "Хайраа, нааш ир."
    menu:
        "Танил хоолойг сонсоод"
        "Хариулах":
            ch_b "Хулан аа?"
        "Түр хүлээх":
            ch_b "Юу болоод байна аа?"
        "Хаалгыг тогших":
            ch_b "Орж болох уу?"
    "Хаалга гэнэт нээгдэв. Хулан биш, инээмсэглэсэн Чингүн зогсож байлаа."
    ch_c "Хайраа!"

    $ stat_location = "Өдөр 2 · Өглөө"
    scene expression kh_background("day_two") with dissolve
    show screen kh_scene_header

    "Билгүүн цочин сэрэв. Утсанд Анугийн шинэ cover бичлэг иржээ."
    $ kh_receive("anu", "Өглөөний мэнд. Чамд зориулж дахиад нэг дуу дууллаа.")
    call kh_listen_cover
    $ stat_day_one_complete = True
    hide screen kh_scene_header
    call screen kh_day_summary
    return

label kh_listen_cover:
    $ kh_cover_path = "audio/story/anu_cover.ogg"
    if renpy.loadable(kh_cover_path):
        $ renpy.music.play(kh_cover_path)
        "Анугийн гитартай cover тоглож байна."
        stop music fadeout 1.0
    else:
        "Анугийн cover бичлэг иржээ. (Дууны файл хараахан нэмэгдээгүй.)"
    return
